  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Remnant.Story.DiaryPageInteractable
  restrictPerspective: 0
  onlyInPerspective: 0
  restrictTimePeriod: 0
  onlyInTimePeriod: 0
  onceOnly: 0
  promptOffset: {x: 0, y: 0.55, z: 0}
  pageNumber: 8
  dateHeader: June 23rd
  pageText: 'I''m so tired. Not sleepy. The kind of tired sleep doesn''t fix.

    There''s
    a storage room at the end of the east hallway. Nobody goes there.

    Nobody
    will have to see me. Nobody will have to look away anymore.

    I''m sorry,
    Mom. I tried to be worth it.'
  panel: {fileID: 1101804383}
