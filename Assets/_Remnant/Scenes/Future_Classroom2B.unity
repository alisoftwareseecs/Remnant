  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1573938131}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 563027f59a172424eab85ea52e8062ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Remnant.Story.DiaryPageInteractable
  restrictPerspective: 0
  onlyInPerspective: 0
  restrictTimePeriod: 0
  onlyInTimePeriod: 0
  onceOnly: 0
  promptOffset: {x: 0, y: 0.55, z: 0}
  pageNumber: 5
  dateHeader: June 2nd
  pageText: 'The police said it was self-defence. An accident. They saw the bruises.
    They said I did nothing wrong.

    Nobody at school heard that part. They only
    heard "she pushed him."

    I live with my aunt now. She doesn''t talk to me.
    Every night I dream about the stairs.'
  panel: {fileID: 1101804383}
  dialogueRunner: {fileID: 1180829029}
  requiresFlags: 
  beforeDialogue: {fileID: 0}
  closeUpBefore: {fileID: 0}
  reactionDialogue: {fileID: 11400000, guid: 4a4cc8666c220f5468d27fc34b4314f0, type: 2}
