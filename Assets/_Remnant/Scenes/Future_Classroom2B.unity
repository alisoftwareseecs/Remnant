--- !u!114 &1602282546
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1602282543}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 563027f59a172424eab85ea52e8062ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Remnant.Story.DiaryPageInteractable
  restrictPerspective: 0
  onlyInPerspective: 0
  restrictTimePeriod: 0
  onlyInTimePeriod: 0
  onceOnly: 0
  promptOffset: {x: 0, y: 0.55, z: 0}
  pageNumber: 4
  dateHeader: May 21st
  pageText: 'I have to write it down or I''ll go crazy.

    He came home angrier
    than I''ve ever seen him. He pinned me against the wall at the top of the stairs.
    I couldn''t breathe.

    I pushed him. I only wanted him to let go.

    He
    fell. He didn''t get up.

    I called the ambulance myself. I held his hand
    until they came. It was the first time I ever held his hand.'
  panel: {fileID: 1101804383}
  dialogueRunner: {fileID: 1180829029}
