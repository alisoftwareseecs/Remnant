%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc52de155aabcf749855155a676eef12, type: 3}
  m_Name: Act4_Aiko_Talk
  m_EditorClassIdentifier: Assembly-CSharp::Remnant.Dialogue.DialogueData
  lines:
  - speaker: 3
    text: Why did you do that?
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 0
    text: I should have done it a long time ago.
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 0
    text: It wasn't your fault. None of it.
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 3
    text: ...How would you know?
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 0
    text: Because I finally looked.
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 3
    text: ...
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 3
    text: No one's ever said that to me.
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 3
    text: I write things down sometimes. No one reads them.
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 0
    text: I would.
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 3
    text: ...Then I'll write something tonight.
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  - speaker: 0
    text: I'll read every word.
    mode: 0
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
  lockPlayer: 1
