  m_Script: {fileID: 11500000, guid: cc52de155aabcf749855155a676eef12, type: 3}
  m_Name: Day2_Shadow_Awaken_Returning
  m_EditorClassIdentifier: Assembly-CSharp::Remnant.Dialogue.DialogueData
  lines:
  - speaker: 1
    text: Back again?
    mode: 1
  - speaker: 1
    text: You remember her, don't you?
    mode: 1
  - speaker: 1
    text: You saw everything yesterday.
    mode: 1
  - speaker: 1
    text: And you looked away.
    mode: 1
  - speaker: 1
    text: Do you want to see where looking away leads?
    mode: 1
