  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc52de155aabcf749855155a676eef12, type: 3}
  m_Name: Storage_Walk_Shadow
  m_EditorClassIdentifier: Assembly-CSharp::Remnant.Dialogue.DialogueData
  lines:
  - speaker: 1
    text: Slower. You don't want to get there, do you?
    mode: 2
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
    blips: 1
    blipGainDb: -3
  - speaker: 1
    text: Everyone saw her. No one looked.
    mode: 2
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
    blips: 1
    blipGainDb: -3
  - speaker: 1
    text: I made sure of that.
    mode: 2
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
    blips: 1
    blipGainDb: -3
  - speaker: 1
    text: Every time she looked at you, I turned your head.
    mode: 2
    fadeColor: 0
    fadeFrom: {r: 1, g: 1, b: 1, a: 1}
    fadeTo: {r: 1, g: 1, b: 1, a: 1}
    fadeLabel: 0
    blips: 1
    blipGainDb: -3
  lockPlayer: 0
